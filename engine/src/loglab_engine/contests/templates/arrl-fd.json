{
  "format": 1,
  "id": "arrl-fd",
  "name": "ARRL Field Day",
  "summary": "Exchange your class and ARRL or RAC section. Each station counts once per band and mode (CW, Phone, Digital).",
  "contest_id": "ARRL-FD",
  "rules": {
    "title": "2026 ARRL Field Day Rules",
    "url": "https://www.arrl.org/files/file/Field-Day/2026/2026-Field-Day-Rules.pdf",
    "revised": "2026-03-01",
    "period": "Fourth full weekend of June, 1800 UTC Saturday to 2059 UTC Sunday (Rule 3)."
  },
  "bands": {
    "allowed": ["160m", "80m", "40m", "20m", "15m", "10m",
                "6m", "4m", "2m", "1.25m", "70cm", "33cm", "23cm", "13cm", "9cm", "6cm",
                "3cm", "1.25cm", "6mm", "4mm", "2.5mm", "2mm", "1mm", "submm"],
    "satellite": true
  },
  "modes": {
    "cw": ["CW"],
    "phone": ["SSB", "AM", "FM", "DIGITALVOICE"]
  },
  "dupes": {
    "per": ["band", "mode"],
    "rule": "Rule 6.3: stations can be worked once per band per mode (Phone, CW, Digital). Rules 6.6 and 6.7: all voice contacts are equivalent, and all non-CW digital contacts are equivalent. Rule 7.3.7: satellite QSOs are their own band."
  },
  "exchange": {
    "sent": [
      {"key": "class", "label": "Your class", "hint": "Transmitters and category, like 3A",
       "pattern": "^[1-9][0-9]?[A-F]$"},
      {"key": "section", "label": "Your section", "hint": "ARRL or RAC section, like KS, or DX",
       "sections": true, "also": ["DX"]}
    ],
    "sent_fields": {"MY_ARRL_SECT": "{section}", "STX_STRING": "{class} {section}"},
    "received": [
      {"key": "class", "field": "CLASS", "label": "Class", "hint": "Like 3A",
       "pattern": "^[1-9][0-9]?[A-F]$"},
      {"key": "section", "field": "ARRL_SECT", "label": "Section", "hint": "Like KS, or DX",
       "sections": true, "also": ["DX"]}
    ]
  },
  "entry": {
    "fields": ["CALL", "CLASS", "ARRL_SECT", "BAND", "MODE", "FREQ", "QSO_DATE", "TIME_ON", "COMMENT"],
    "live": true
  },
  "layout": {
    "modules": [
      {"id": "entry", "width": "half", "side": "left"},
      {"id": "map", "width": "half", "side": "right"},
      {"id": "journal"},
      {"id": "log"},
      {"id": "detail"}
    ],
    "log_columns": ["time", "call", "band", "mode", "field:CLASS", "field:ARRL_SECT", "operator"]
  }
}
